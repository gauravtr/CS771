def my_decode(w):
    ################################
    #  Non Editable Region Ending  #
    ################################

    # Use this method to invert a PUF linear model to get back delays
    # w is a single 65-dim vector (last dimension being the bias term)
    # The output should be four 64-dimensional vectors

    def construct_delays(w_vec, bias):
        p = np.zeros(64)
        p[0] = 2.000000002 * w_vec[0]
        for i in range(1, 63):
            p[i] = 2.000000002 * w_vec[i] - p[i - 1]
        p[63] = w_vec[63] + bias - 0.5 * p[62]
        return p

    def ensure_non_negative(*arrays):
        stacked = np.concatenate(arrays)
        min_val = np.min(stacked)
        if min_val < 0:
            shift = -min_val
            return [arr + shift for arr in arrays]
        return arrays

    w = np.asarray(w, dtype=np.float64).flatten()
    main_weights = w[:-1]
    bias_term = w[-1]

    p = construct_delays(main_weights, bias_term)
    q = np.zeros(64)
    r = np.zeros(64); r[-1] = p[-1] - 2 * bias_term
    s = np.zeros(64)

    p, q, r, s = ensure_non_negative(p, q, r, s)
    return p, q, r, s
