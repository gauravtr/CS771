import numpy as np

from sklearn.svm import LinearSVC, SVC
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score


# ============================================================
# 1. ARBITER PUF FEATURE TRANSFORMATION
# ============================================================

def arbiter_feature_map(X):
    """
    Convert 64-bit binary challenges into the standard
    64-dimensional Arbiter-PUF feature representation.

    Input:
        X : shape (n_samples, 64)
            Binary challenges containing 0/1.

    Output:
        Phi : shape (n_samples, 64)
            Arbiter-PUF feature matrix.
    """

    X = np.asarray(X, dtype=np.int8)

    if X.ndim != 2:
        raise ValueError("X must be a 2D array.")

    if X.shape[1] != 64:
        raise ValueError("This project uses a 64-bit Arbiter PUF.")

    # 0 -> +1
    # 1 -> -1
    X_sign = 1 - 2 * X

    n_samples = X.shape[0]

    Phi = np.ones((n_samples, 64), dtype=np.float64)

    # phi_i = product of signed challenge bits
    # from stage i to stage 64.
    running_product = np.ones(n_samples, dtype=np.float64)

    for i in range(63, -1, -1):
        running_product *= X_sign[:, i]
        Phi[:, i] = running_product

    return Phi


# ============================================================
# 2. LINEAR SVC
# ============================================================

def train_linear_svc(X_train, y_train, C=1.0):
    """
    L2-regularized linear SVM with hinge loss.
    """

    model = LinearSVC(
        C=C,
        loss="hinge",
        penalty="l2",
        dual=True,
        tol=1e-4,
        max_iter=20000
    )

    model.fit(X_train, y_train)

    return model


# ============================================================
# 3. LOGISTIC REGRESSION
# ============================================================

def train_logistic_regression(X_train, y_train, C=1.0):
    """
    L2-regularized Logistic Regression.
    """

    model = LogisticRegression(
        C=C,
        penalty="l2",
        solver="lbfgs",
        max_iter=5000
    )

    model.fit(X_train, y_train)

    return model


# ============================================================
# 4. DEGREE-8 POLYNOMIAL KERNEL SVM
# ============================================================

def train_polynomial_svc(X_train, y_train,
                         degree=8,
                         C=1.0,
                         gamma="scale"):
    """
    Polynomial-kernel SVM.

    The polynomial kernel is:

        K(x,z) = (gamma * x^T z + coef0)^degree

    with degree = 8 in this project.
    """

    model = SVC(
        kernel="poly",
        degree=degree,
        C=C,
        gamma=gamma,
        coef0=1.0,
        max_iter=-1
    )

    model.fit(X_train, y_train)

    return model


# ============================================================
# 5. PREDICTION
# ============================================================

def predict_apuf(model, X):
    """
    Predict responses for raw 64-bit challenges.
    """

    Phi = arbiter_feature_map(X)

    return model.predict(Phi)


# ============================================================
# 6. MODEL EVALUATION
# ============================================================

def evaluate_model(model, X_test, y_test):
    """
    Return classification accuracy on unseen CRPs.
    """

    Phi_test = arbiter_feature_map(X_test)

    y_pred = model.predict(Phi_test)

    return accuracy_score(y_test, y_pred)


# ============================================================
# 7. 64 + 1 MODEL EXTRACTION
# ============================================================

def extract_linear_model_parameters(model):
    """
    Extract the 64 learned weights and one bias term.

    Returned vector:
        [w1, w2, ..., w64, b]

    Total parameters = 65.
    """

    if not hasattr(model, "coef_"):
        raise ValueError(
            "The model must be a linear classifier with coef_."
        )

    weights = model.coef_.reshape(-1)

    bias = float(model.intercept_[0])

    if weights.shape[0] != 64:
        raise ValueError(
            f"Expected 64 model weights, got {weights.shape[0]}."
        )

    return np.concatenate(
        [weights, np.array([bias])]
    )


# ============================================================
# 8. DELAY PARAMETER INVERSION
# ============================================================

def recover_delay_parameters(model_parameters):
    """
    Recover four 64-dimensional delay vectors
    from the 64 + 1 learned model representation.

    Total recovered hardware parameters:
        4 x 64 = 256
    """

    params = np.asarray(
        model_parameters,
        dtype=np.float64
    ).reshape(-1)

    if params.shape[0] != 65:
        raise ValueError(
            "The learned APUF model must contain 64 weights "
            "and 1 bias."
        )

    w = params[:64]
    b = params[64]

    # --------------------------------------------------------
    # Recover stage-delay difference parameters.
    #
    # The exact indexing/sign convention depends on the
    # forward APUF formulation used during modeling.
    # --------------------------------------------------------

    delta = np.zeros(64, dtype=np.float64)

    delta[0] = 2.0 * w[0]

    for i in range(1, 63):
        delta[i] = 2.0 * w[i] - delta[i - 1]

    delta[63] = w[63] + b - 0.5 * delta[62]

    # --------------------------------------------------------
    # Construct four 64-dimensional hardware vectors.
    #
    # These correspond to four delay-parameter groups in
    # the two-path switch representation.
    # --------------------------------------------------------

    p = np.zeros(64, dtype=np.float64)
    q = np.zeros(64, dtype=np.float64)
    r = np.zeros(64, dtype=np.float64)
    s = np.zeros(64, dtype=np.float64)

    p[:] = delta

    # One valid relative-delay representation.
    # Absolute delays have a common-shift ambiguity, so the
    # recovered values can be shifted by a constant.
    r[-1] = delta[-1] - 2.0 * b

    # --------------------------------------------------------
    # Shift all parameters together so that the minimum
    # delay is zero.
    # --------------------------------------------------------

    all_values = np.concatenate([p, q, r, s])

    min_value = np.min(all_values)

    if min_value < 0:
        shift = -min_value

        p += shift
        q += shift
        r += shift
        s += shift

    return p, q, r, s


# ============================================================
# 9. 15+ EXPERIMENTAL SETTINGS
# ============================================================

def run_experiments(X_train,
                    y_train,
                    X_test,
                    y_test):
    """
    Run multiple configurations covering:

        - Linear SVC
        - Logistic Regression
        - Polynomial SVC
        - multiple C values
        - polynomial degrees

    This is useful for the '15+ settings' claim.
    """

    results = []

    Phi_train = arbiter_feature_map(X_train)
    Phi_test = arbiter_feature_map(X_test)

    # --------------------------------------------------------
    # Linear SVC experiments
    # --------------------------------------------------------

    for C in [0.01, 0.1, 1.0, 10.0, 100.0]:

        model = LinearSVC(
            C=C,
            loss="hinge",
            penalty="l2",
            dual=True,
            tol=1e-4,
            max_iter=20000
        )

        model.fit(Phi_train, y_train)

        pred = model.predict(Phi_test)

        acc = accuracy_score(y_test, pred)

        results.append({
            "model": "LinearSVC",
            "regularization": "L2",
            "loss": "hinge",
            "C": C,
            "degree": None,
            "accuracy": acc
        })

    # --------------------------------------------------------
    # Logistic Regression experiments
    # --------------------------------------------------------

    for C in [0.01, 0.1, 1.0, 10.0, 100.0]:

        model = LogisticRegression(
            C=C,
            penalty="l2",
            solver="lbfgs",
            max_iter=5000
        )

        model.fit(Phi_train, y_train)

        pred = model.predict(Phi_test)

        acc = accuracy_score(y_test, pred)

        results.append({
            "model": "LogisticRegression",
            "regularization": "L2",
            "loss": "log-loss",
            "C": C,
            "degree": None,
            "accuracy": acc
        })

    # --------------------------------------------------------
    # Polynomial SVM experiments
    # --------------------------------------------------------

    for degree in [2, 4, 6, 8, 10]:

        model = SVC(
            kernel="poly",
            degree=degree,
            C=1.0,
            gamma="scale",
            coef0=1.0
        )

        model.fit(Phi_train, y_train)

        pred = model.predict(Phi_test)

        acc = accuracy_score(y_test, pred)

        results.append({
            "model": "PolynomialSVC",
            "regularization": "SVM",
            "loss": "hinge/margin",
            "C": 1.0,
            "degree": degree,
            "accuracy": acc
        })

    return results
