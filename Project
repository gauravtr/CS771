def my_map(X):
    ################################
    #  Non Editable Region Ending  #
    ################################

    # Use this method to create features.
    # It is likely that my_fit will internally call my_map to create features for train points
   
    def interaction_terms(X_bin, order, limit=None):
        features = []
        combos = itertools.combinations(range(X_bin.shape[1]), order)
        for idx, indices in enumerate(combos):
            prod = np.prod(X_bin[:, list(indices)], axis=1).reshape(-1, 1)
            features.append(prod)
            if limit and idx + 1 >= limit:
                break
        return features

    X_sign = 1 - 2 * X  # Convert {0,1} to {1,-1}
    base = [X_sign]
    base += interaction_terms(X_sign, 2)
    base += interaction_terms(X_sign, 3, limit=30)
    base += interaction_terms(X_sign, 4, limit=24)

    return np.hstack(base)

